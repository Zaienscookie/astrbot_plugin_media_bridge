{
  "whitelist": {
    "description": "白名单（开启后仅白名单群/用户可用）",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用白名单",
        "type": "bool",
        "default": false
      },
      "groups": {
        "description": "白名单群号",
        "type": "string",
        "hint": "多个用逗号分隔，如: 123456,789012",
        "default": ""
      },
      "users": {
        "description": "白名单用户QQ",
        "type": "string",
        "hint": "多个用逗号分隔，如: 891584823",
        "default": ""
      }
    }
  },
  "proxy": {
    "description": "代理设置（手动配置）",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用代理",
        "type": "bool",
        "default": true
      },
      "url": {
        "description": "代理地址",
        "type": "string",
        "hint": "http://127.0.0.1:7890 或 socks5://host:port",
        "default": "http://127.0.0.1:7890"
      },
      "youtube": {
        "description": "YouTube 走代理",
        "type": "bool",
        "default": true
      },
      "bluesky": {
        "description": "Bluesky 走代理",
        "type": "bool",
        "default": true
      },
      "twitter": {
        "description": "Twitter 走代理",
        "type": "bool",
        "default": true
      }
    }
  },
  "quality": {
    "description": "画质设置（能高清就高清）",
    "type": "object",
    "items": {
      "youtube": {
        "description": "YouTube 画质",
        "type": "string",
        "hint": "max/720p/1080p",
        "default": "max"
      },
      "twitter": {
        "description": "Twitter 媒体",
        "type": "string",
        "hint": "hd/orig",
        "default": "hd"
      },
      "bluesky": {
        "description": "Bluesky 媒体",
        "type": "string",
        "hint": "fullsize/thumb",
        "default": "fullsize"
      }
    }
  },
  "max_video_mb": {
    "description": "视频最大下载(MB)",
    "type": "float",
    "default": 50.0
  }
}